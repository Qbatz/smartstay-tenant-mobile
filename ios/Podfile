# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# The Dev and Prod schemes each build a Debug and a Release configuration. CocoaPods needs to know
# which is which; the env file each one reads is its ENVFILE build setting in the Xcode project.
project 'smartstayTenant',
  'DevDebug' => :debug,
  'DevRelease' => :release,
  'ProdDebug' => :debug,
  'ProdRelease' => :release

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'smartstayTenant' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Digio KYC, launched from CommonModule.verifyKyc. DigioCaptureKit adds the selfie step.
  pod 'DigiokycSDK', '~> 2.0'
  pod 'DigioCaptureKit', '~> 2.0'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 fails the build for deployment targets below iOS 15.0.
    # react_native_post_install only raises each pod's main target, so
    # resource bundle targets keep the older value from their podspec.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if deployment_target && deployment_target.to_f < min_ios_version_supported.to_f
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end

        # fmt 11.0.2 enables consteval format-string checks under C++20, which
        # the clang shipped with Xcode 27 fails to compile. Building fmt itself
        # as C++17 turns those checks off.
        if target.name == 'fmt'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    # react-native-config reads the env file from its own pod target, which cannot see the app's
    # build settings, so give it each configuration's ENVFILE from the Xcode project.
    envfiles = installer.aggregate_targets.first.user_project.build_configurations.to_h do |c|
      [c.name, c.build_settings['ENVFILE']]
    end
    config_target = installer.pods_project.targets.find { |t| t.name == 'react-native-config' }
    raise 'react-native-config pod target not found' unless config_target
    envfiles.each do |name, envfile|
      raise "ENVFILE is not set for #{name} in smartstayTenant.xcodeproj" unless envfile
    end
    # The Pods project also keeps its own Debug/Release configurations, which the app never builds.
    config_target.build_configurations.each do |build_config|
      envfile = envfiles[build_config.name]
      build_config.build_settings['ENVFILE'] = envfile if envfile
    end
  end
end
